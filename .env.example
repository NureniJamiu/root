# Copy to .env and fill in. Never commit .env.

# Signs sessions and reset tokens. Required in production.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of the app (where people open it). In development this is the
# Vite dev server; in production, your domain, e.g. https://root.example.com
BETTER_AUTH_URL=http://localhost:5173
VITE_APP_URL=http://localhost:5173

# Port of the API server (and of the whole app in production).
PORT=3001

# SQLite database file. Defaults to ./auth.db. Keep it on a persistent disk.
# DATABASE_PATH=/var/data/root.db

# Password reset email through Resend (https://resend.com). Without these the
# reset link is printed to the server log instead of emailed.
# RESEND_API_KEY=
# EMAIL_FROM=Root <hello@your-domain.com>

# Serve the built app (dist/) from the API server. On by default when
# NODE_ENV=production; set to 1 to try it locally after `npm run build`.
# SERVE_APP=1

# Development and e2e only: keep sent mail in memory at /api/dev/mailbox.
# Ignored in production.
# DEV_MAILBOX=1
