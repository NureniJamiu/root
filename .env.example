# Copy to .env and fill in. Never commit .env.

# Signs sessions and reset tokens. Required in production.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of the app (where people open it). In development this is the
# Vite dev server; in production, your domain, e.g. https://root.example.com
BETTER_AUTH_URL=http://localhost:5173
VITE_APP_URL=http://localhost:5173

# Port of the API server (and of the whole app in production).
PORT=3001

# SQLite database file. Defaults to ./auth.db. Keep it on a persistent disk.
# DATABASE_PATH=/var/data/root.db

# Password reset email through Resend (https://resend.com). Without these the
# reset link is printed to the server log instead of emailed.
# RESEND_API_KEY=
# EMAIL_FROM=Root <hello@your-domain.com>

# Serve the built app (dist/) from the API server. On by default when
# NODE_ENV=production; set to 1 to try it locally after `npm run build`.
# SERVE_APP=1

# Development and e2e only: keep sent mail in memory at /api/dev/mailbox.
# Ignored in production.
# DEV_MAILBOX=1

# ---------------------------------------------------------------- AI ----
# AI features are off until at least one provider below is configured.
# People can also add their own keys in AI settings.

# Google Gemini (default). Free key: https://aistudio.google.com/apikey
# GOOGLE_GENERATIVE_AI_API_KEY=

# Anthropic Claude (paid; premium models, Pro plan only on this key).
# ANTHROPIC_API_KEY=

# OpenRouter: one key for many models, including free ones (":free").
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-oss-120b:free

# Ollama on your own machine (nothing leaves it). Needs no key.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Default models, as provider:model. Fast work (map, expand, rewrite) and drafts.
# AI_DEFAULT_MODEL=google:gemini-3.8-flash
# AI_SMART_MODEL=google:gemini-3.8-flash   (google:gemini-3.1-pro-preview needs billing)

# Plan for people without one stored: free or pro. Defaults to pro in
# development and free in production. Limits live in src/lib/ai/plans.ts.
# AI_DEFAULT_PLAN=pro

# Encrypts the API keys people save. Defaults to BETTER_AUTH_SECRET. Set it
# once and keep it: changing it makes saved keys unreadable.
# AI_KEY_SECRET=
