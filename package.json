{
  "name": "root-mvp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently \"npm run dev\" \"npm run auth-server:watch\"",
    "auth-server": "tsx server.ts",
    "auth-server:watch": "tsx watch server.ts",
    "auth:migrate": "tsx migrate.ts",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "start": "NODE_ENV=production tsx server.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest",
    "test:run": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.65",
    "@ai-sdk/google": "4.0.82",
    "@ai-sdk/openai-compatible": "3.0.57",
    "@floating-ui/dom": "1.7.4",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-bubble-menu": "3.31.4",
    "@tiptap/extension-file-handler": "3.31.4",
    "@tiptap/extension-highlight": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-mention": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-typography": "3.31.4",
    "@tiptap/extension-unique-id": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/suggestion": "3.31.4",
    "ai": "7.0.118",
    "better-auth": "^1.7.7",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "reactflow": "11.11.4",
    "tsx": "4.23.15",
    "zod": "3.25.76",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitejs/plugin-react": "4.3.3",
    "@vitest/ui": "^2.1.4",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "eslint": "8.57.1",
    "eslint-plugin-react": "7.37.2",
    "fast-check": "^3.23.1",
    "jsdom": "^25.0.1",
    "tailwindcss": "^3.4.19",
    "typescript": "5.5.4",
    "vite": "5.4.10",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20.19"
  }
